# ArxMint — Caddyfile
# Automatic HTTPS via Let's Encrypt / ZeroSSL.
# Set DOMAIN and CADDY_EMAIL in your .env before starting.
#
# Usage: docker compose up -d caddy
# Cert storage: caddy-data volume (persists across restarts)

{
  email {$CADDY_EMAIL}
}

# Main app — ArxMint web interface
{$DOMAIN} {
  reverse_proxy web:3000
}

# Grafana monitoring dashboard (optional subdomain)
grafana.{$DOMAIN} {
  reverse_proxy grafana:3000
}

# Internal services NOT exposed via Caddy (internal sovereign network only):
#   - LND gRPC  (10009) — use lncli via docker exec or tunnel
#   - LND REST  (8080)  — access via docker exec or SSH tunnel
#   - Postgres  (5432)  — internal only, no external access
#   - Prometheus (9090) — internal only (Grafana reads it)
