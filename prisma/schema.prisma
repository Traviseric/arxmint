// ============================================================
// ArxMint — Prisma Schema
// Cashu proofs NEVER touch this DB. Proofs are client-side only (IndexedDB). See lib/cashu-vault.ts
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  void
}

enum InvoiceCurrency {
  BTC
  USD
}

enum InvoicePaymentRail {
  lightning
  cashu
  stripe
}

model Community {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  prompt    String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchants    Merchant[]
  transactions Transaction[]

  @@map("communities")
}

model Merchant {
  id               String    @id @default(cuid())
  communityId      String
  community        Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  name             String
  description      String?
  category         String?
  cashuAddress     String?
  lightningAddress String?
  metadata         Json?     // location, paymentMethods[], contactInfo, etc.
  createdAt        DateTime  @default(now())

  @@map("merchants")
}

model Transaction {
  id           String    @id @default(cuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  type         String    // send | receive | swap
  amount       Int
  backend      String    // cashu | lightning | fedimint
  timestamp    DateTime  @default(now())
  status       String    // pending | confirmed | failed
  counterparty String?
  notes        String?   // non-sensitive metadata only — NO raw proofs

  @@map("transactions")
}

model User {
  id            String    @id @default(cuid())
  nostrPubkey   String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  communities     Community[]
  merchants       Merchant[]
  identityAliases IdentityAlias[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PaymentChallenge {
  id        String    @id
  type      String    // l402 | cashu
  amount    Int
  backend   String    // lightning | cashu
  status    String    // pending | paid | expired
  expiresAt DateTime
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  notes     String?   // JSON: full challenge details (no secrets — invoice and macaroon are public)

  @@map("payment_challenges")
}

model IdentityAlias {
  id         String   @id @default(cuid())
  rootId     String   // ArxMint User.id — the resolved root identity
  root       User     @relation(fields: [rootId], references: [id], onDelete: Cascade)
  namespace  String   // caller-defined (lowercase alphanumeric, hyphens, underscores)
  externalId String   // the foreign ID (e.g. "aos_vis-456", "us-west-2:cognito-uuid")
  linkedBy   String   // which system created the link (e.g. "teneo-production", "analyticsos")
  metadata   Json?    // optional context (e.g. { siteId, linkedDuring: "signup" })
  linkedAt   DateTime @default(now())

  @@unique([namespace, externalId]) // one external ID can only resolve to one root
  @@index([rootId])                 // fast lookup: "give me all aliases for this user"
  @@index([externalId])             // fast lookup: "resolve any ID without knowing namespace"
  @@map("identity_aliases")
}

model MerchantPledge {
  id           String   @id @default(cuid())
  businessName String
  contactName  String
  email        String
  location     String?
  category     String?  // food-drink, retail, services, health, entertainment, technology, other
  website      String?
  logoUrl      String?  // URL to merchant logo image
  reason       String?  // why they want to join the network
  emailOptIn   Boolean  @default(false) // opted in to launch notifications
  featured     Boolean  @default(false) // highlighted on landing page
  approved     Boolean  @default(false) // must be approved before showing on /merchants
  createdAt    DateTime @default(now())

  @@map("merchant_pledges")
}

model Invoice {
  id                   String             @id @default(cuid())
  invoiceNumber        String             @unique
  fromOrgId            String
  fromOrgName          String?
  toOrgId              String
  toOrgName            String?
  merchantId           String?
  status               InvoiceStatus      @default(draft)
  currency             InvoiceCurrency
  paymentRail          InvoicePaymentRail @default(lightning)
  subtotalMinor        Int
  totalMinor           Int
  dueDate              DateTime?
  sentAt               DateTime?
  paidAt               DateTime?
  voidedAt             DateTime?
  paymentSessionId     String?            @unique
  paymentLink          String?
  notes                String?
  metadata             Json?
  createdByUserId      String?
  createdByNostrPubkey String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  lineItems InvoiceLineItem[]

  @@index([fromOrgId, status])
  @@index([toOrgId, status])
  @@index([merchantId, status])
  @@index([dueDate, status])
  @@map("invoices")
}

model InvoiceLineItem {
  id               String          @id @default(cuid())
  invoiceId        String
  description      String
  quantity         Int             @default(1)
  unitAmountMinor  Int
  totalAmountMinor Int
  currency         InvoiceCurrency
  sortOrder        Int             @default(0)
  metadata         Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("invoice_line_items")
}

model PayoutConfig {
  id            String   @id @default(cuid())
  merchantId    String   @unique
  schedule      String   @default("daily") // "daily" | "weekly" | "on_threshold"
  thresholdSats BigInt?  // only when schedule="on_threshold"
  rail          String   @default("lightning") // "ecash" | "lightning" | "onchain"
  destination   String   // Lightning address, on-chain address, or ecash pubkey
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payout_configs")
}

model Payout {
  id          String   @id @default(cuid())
  merchantId  String
  amountSats  BigInt
  rail        String
  destination String
  status      String   @default("pending") // pending|processing|completed|failed
  txRef       String?  // Lightning payment hash, on-chain txid, or ecash token
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@map("payouts")
}

model Escrow {
  id               String       @id @default(cuid())
  payerId          String
  payeeId          String
  amountSats       BigInt
  currency         String       @default("BTC")
  releaseCondition String       // manual | time_based | delivery_confirmed | dispute_resolved
  releasesAt       DateTime?
  status           String       @default("pending_funding") // pending_funding|funded|released|disputed|resolved|voided
  invoiceId        String?
  paymentSessionId String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  events EscrowEvent[]

  @@index([payerId, status])
  @@index([payeeId, status])
  @@index([status, releasesAt])
  @@map("escrows")
}

model EscrowEvent {
  id        String   @id @default(cuid())
  escrowId  String
  type      String   // funded|released|disputed|resolved|voided
  actor     String?
  note      String?
  createdAt DateTime @default(now())

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
  @@map("escrow_events")
}
